# Web listener. Use :8080 or 127.0.0.1:8080 behind a reverse proxy.
LISTEN_ADDR=:8080

# When the requested port is busy, try the next ports automatically.
AUTO_PORT=true
AUTO_PORT_ATTEMPTS=20

# SQLite database directory.
DATA_DIR=./data

# Used only when the database has not been initialized yet.
# If omitted, a random password is generated and printed once at startup.
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional one-time password reset. Remove this variable after restarting.
# RESET_ADMIN_PASSWORD=replace-with-a-new-password

# Optional initial API token. A random token is generated when omitted.
# API_TOKEN=shm_replace_with_a_random_token

# Public stock endpoint used by the poller.
STOCK_SOURCE_URL=https://shockhosting.com/api/server-stock.php
