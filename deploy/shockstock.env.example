LISTEN_ADDR=127.0.0.1:8080
AUTO_PORT=false
AUTO_PORT_ATTEMPTS=20
DATA_DIR=/var/lib/shockstock
ADMIN_PASSWORD=replace-with-a-strong-password
STOCK_SOURCE_URL=https://shockhosting.com/api/server-stock.php

